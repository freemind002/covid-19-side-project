# ==========================================
# 1. 全域 / 作業系統暫存檔 (Global / OS)
# ==========================================
.DS_Store
Thumbs.db
*.log

# ==========================================
# 2. 後端專案：Spring Boot (位於 backend/)
# ==========================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/build/
backend/*.class

# 後端 IDE 與工具設定 (IntelliJ IDEA / Eclipse / STS)
backend/.idea/
backend/*.iml
backend/*.iws
backend/*.ipr
backend/.classpath
backend/.project
backend/.settings/
backend/.factorypath
backend/.springBeans
backend/.sts4-cache
backend/.sts-sync-lock

# ==========================================
# 3. 前端專案：Vue 3 / Vite (位於 frontend/)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/*.local
frontend/.tsbuildinfo
frontend/.eslintcache

# 前端 IDE / Editor 設定
frontend/.vscode/*
!frontend/.vscode/extensions.json
frontend/.idea/
frontend/*.suo
frontend/*.ntvs*
frontend/*.njsproj
frontend/*.sln
frontend/*.sw?

# 前端測試與暫存
frontend/cypress/videos/
frontend/cypress/screenshots/
frontend/__screenshots__/
frontend/*.timestamp-*-*.mjs